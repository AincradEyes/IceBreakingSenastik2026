rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      // Leaderboard dapat dibaca publik. Peserta harus login anonim untuk mengirim skor.
      allow read: if true;
      // Hanya membuat dokumen baru; tidak boleh mengubah atau menghapus skor.
      // Validasi ini mengurangi data tak valid, tetapi tidak membuktikan skor benar.
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['name', 'score', 'total', 'uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'score', 'total', 'uid', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 130
        && request.resource.data.total == 130
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}